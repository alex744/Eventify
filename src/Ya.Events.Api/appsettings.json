{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=events_db;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "users-api",
    "Audience": "events-api, bookings-api",
    "LifetimeMinutes": 60
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "booking-processing"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "EventByIdTtlMinutes": 5,
    "TopEventsTtlMinutes": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
